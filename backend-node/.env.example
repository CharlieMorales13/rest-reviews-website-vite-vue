# ── Base de datos ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_KEY="your-supabase-anon-key"

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET="cambia-esto-por-un-secreto-seguro-de-minimo-32-chars"
JWT_EXPIRES_IN="24h"

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── CORS y URLs ───────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
# En producción: https://anahuac-eats.com
CORS_ORIGINS=http://localhost:5173
# En producción: http://backend-analytics:8001
ANALYTICS_URL=http://localhost:8001

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="Anáhuac EATS <noreply@anahuac-eats.com>"

# ── Cookies ───────────────────────────────────────────────────────────────────
# Dejar vacío en local. En producción: .anahuac-eats.com
COOKIE_DOMAIN=

# ── Moderación de imágenes (Sightengine) ─────────────────────────────────────
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
